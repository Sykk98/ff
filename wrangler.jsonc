// Configurazione per pubblicare l'app come Cloudflare Worker (Workers & Pages → Worker collegato a GitHub).
// Cloudflare la legge a ogni pubblicazione: i file di docs/ diventano l'app,
// e le richieste /api/* passano dal Worker, che contiene il ponte per Mistral.
// Segreti da impostare in Settings → Variables and Secrets: MISTRAL_API_KEY e APP_PASSWORD.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ff",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
