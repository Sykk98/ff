# Copia questo file in .env oppure configura tutto dalla finestra Impostazioni dell'app.
# Qualsiasi endpoint compatibile con l'API OpenAI /chat/completions funziona.

# OpenRouter (molti modelli, inclusi quelli che ammettono contenuti per adulti)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

# Ollama in locale (nessuna chiave necessaria)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=nome-del-modello

# Porta e indirizzo del server web
PORT=3000
HOST=127.0.0.1
