# Copia questo file in .env oppure configura tutto dalla finestra Impostazioni dell'app.
# I valori salvati dall'interfaccia hanno la precedenza.

# --- Ollama (predefinito, locale e gratuito) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral-nemo

# --- Oppure un servizio compatibile OpenAI ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Porta e indirizzo del server web
PORT=3000
HOST=127.0.0.1
